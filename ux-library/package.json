{
	"name": "@michel005/ux-library",
	"private": false,
	"version": "1.0.0",
	"description": "React UX component library",
	"license": "MIT",
	"author": "michel005",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/michel005/ux.git",
		"directory": "ux-library"
	},
	"homepage": "https://github.com/michel005/ux/tree/main/ux-library#readme",
	"bugs": {
		"url": "https://github.com/michel005/ux/issues"
	},
	"type": "module",
	"sideEffects": [
		"*.css",
		"*.scss"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/index.js"
		},
		"./index.css": "./dist/index.css"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "vite build && tsc -p tsconfig.lib.json",
		"build:watch": "vite build --watch",
		"types:watch": "tsc -p tsconfig.lib.json --watch",
		"dev": "concurrently \"pnpm run build:watch\" \"pnpm run types:watch\"",
		"prepublishOnly": "pnpm run build"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"material-symbols": "^0.45.10",
		"zustand": "^5.0.14"
	},
	"peerDependencies": {
		"react": ">=19",
		"react-dom": ">=19",
		"react-hook-form": "^7.84.0"
	},
	"devDependencies": {
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.4",
		"concurrently": "^9.2.1",
		"prettier": "^3.9.6",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"sass": "^1.102.0",
		"typescript": "~6.0.2",
		"vite": "8.2.0",
		"vite-plugin-dts": "^5.0.3"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": false
	}
}
