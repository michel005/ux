{
	"name": "ux-library",
	"private": false,
	"version": "0.0.0",
	"type": "module",
	"main": "./src/index.ts",
	"module": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./index.css": "./dist/index.css"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build:watch": "vite build --watch",
		"types:watch": "tsc -p tsconfig.lib.json --watch",
