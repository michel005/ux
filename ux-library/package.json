	},
	"dependencies": {
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"material-symbols": "^0.45.10",
		"zustand": "^5.0.14"
	},
	"peerDependencies": {
		"react": ">=19",
		"react-dom": ">=19",
		"react-hook-form": "^7.84.0"
	},
	"devDependencies": {
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.4",
		"concurrently": "^9.2.1",
		"prettier": "^3.9.6",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"sass": "^1.102.0",
		"typescript": "~6.0.2",
		"vite": "8.2.0",
		"vite-plugin-dts": "^5.0.3"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": false
	}
